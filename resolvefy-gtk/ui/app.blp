using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: _("Resolvefy");
  default-width: 650;
  default-height: 650;

  Adw.ToolbarView toolbar_view {
    Adw.HeaderBar header_bar {}

    Adw.Clamp clamp {
      maximum-size: 600;
      margin-top: 12;
      margin-bottom: 50;
      margin-start: 12;
      margin-end: 12;

      Gtk.Box {
        orientation: vertical;
        spacing: 12;

        Gtk.Label {
          label: _("Resolvefy");

          styles [
            "title-1",
          ]

          halign: center;
        }

        Gtk.Label {
          label: _("Conversor de vídeo a AV1");

          styles [
            "dim-label",
          ]

          halign: center;
        }

        Adw.PreferencesGroup {
          title: _("Entrada");

          Adw.ActionRow {
            title: _("Archivo de vídeo");
            activatable: true;

            Gtk.Button pick_input_btn {
              label: _("Seleccionar…");
              valign: center;
            }

            activatable-widget: pick_input_btn;
          }

          Gtk.Label input_path_label {
            label: _("Ningún archivo seleccionado");
            wrap: true;
            xalign: 0.0;

            styles [
              "dim-label",
            ]
          }

          Gtk.Revealer info_revealer {
            transition-type: slide_down;

            Gtk.Label info_label {
              wrap: true;
              xalign: 0.0;
            }
          }
        }

        Adw.PreferencesGroup {
          title: _("Salida");

          Adw.ActionRow output_row {
            title: _("Guardar como");
            subtitle: _("Sin ruta de salida");
            activatable: true;
            // styles ["property"]

            Gtk.Button pick_output_btn {
              label: _("Seleccionar…");
              valign: center;
              sensitive: false;
            }

            activatable-widget: pick_output_btn;
          }

        }

        Adw.PreferencesGroup {
          title: _("Codificación");

          Adw.ExpanderRow encoding_expander {
            title: _("Opciones avanzadas");
            subtitle: _("Modo CRF, bitrate, etc.");

            Adw.ComboRow mode_combo {
              title: _("Modo de codificación");
              selected: 0;
            }

            Adw.EntryRow crf_row {
              title: _("Valor CRF (1–63)");
              text: _("24");
            }

            Adw.EntryRow bitrate_row {
              title: _("Bitrate (kbps)");
              text: _("5000");
              visible: false;
            }
          }
        }

        Gtk.Label status_label {
          label: _("Preparado");


          xalign: 0.0;
        }

        Gtk.ProgressBar progress_bar {
          text: _("Progreso");
        }

        Gtk.Button convert_button {
          label: _("Convertir");

          styles [
            "suggested-action",
            "pill",
          ]

          halign: center;
          sensitive: false;
        }
      }
    }
  }
}
