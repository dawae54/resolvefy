using Gtk 4.0;
using Adw 1;

Adw.Window window {
  title: _("Resolvefy");
  default-width: 500;
  default-height: 600;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Gtk.ScrolledWindow {
      vscrollbar-policy: automatic;

      child: Adw.Clamp {
        maximum-size: 600;

        child: Box {
          orientation: vertical;
          spacing: 12;
          margin-bottom: 24;
          margin-start: 24;
          margin-end: 24;

          Adw.PreferencesGroup {
            title: _("Entrada");

            Adw.ActionRow input_row {
              title: _("Archivo de entrada");
              subtitle: _("Ningún archivo seleccionado");

              [suffix]
              Button input_button {
                label: _("Examinar…");
                valign: center;
              }
            }

            Adw.ExpanderRow info_group {
              title: _("Información del archivo");
              sensitive: false;

              Adw.ActionRow codec_video_row {
                title: _("Códec de vídeo");
                subtitle: _("—");
              }

              Adw.ActionRow codec_audio_row {
                title: _("Códec de audio");
                subtitle: _("—");
              }

              Adw.ActionRow duration_row {
                title: _("Duración");
                subtitle: _("—");
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Salida");

            Adw.ActionRow output_row {
              title: _("Archivo de salida");
              subtitle: _("Sin ruta de salida");

              [suffix]
              Button output_button {
                label: _("Examinar…");
                sensitive: false;
                valign: center;
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Avanzado");

            Adw.ExpanderRow {
              title: _("Opciones de codificación");

              Adw.ActionRow mode_row {
                title: _("Modo");

                [suffix]
                DropDown mode_combo {
                  valign: center;
                }
              }

              Adw.ActionRow crf_row {
                title: _("Valor CRF (1–63)");

                [suffix]
                SpinButton crf_spin {
                  adjustment: Adjustment {
                    lower: 1;
                    upper: 63;
                    step-increment: 1;
                    value: 24;
                  };

                  valign: center;
                }
              }

              Adw.ActionRow bitrate_row {
                title: _("Bitrate constante (kbps)");
                visible: false;

                [suffix]
                SpinButton bitrate_spin {
                  adjustment: Adjustment {
                    lower: 100;
                    upper: 100000;
                    value: 5000;
                    step-increment: 100;
                  };

                  valign: center;
                }
              }
            }
          }

          Box {
            orientation: horizontal;
            spacing: 8;

            Label status_label {
              label: _("Preparado");
              xalign: 0;
              hexpand: true;
            }

            Label percent_label {
              label: _("0%");
              xalign: 1;
              visible: false;
            }
          }

          ProgressBar progress_bar {
            text: _("");
          }

          Button convert_button {
            label: _("Convertir");

            styles [
              "suggested-action",
              "pill",
            ]

            hexpand: true;
            sensitive: false;
          }
        };
      };
    };
  };
}
