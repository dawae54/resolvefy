import {
    Button,
    LineEdit,
    ComboBox,
    ProgressIndicator,
    VerticalBox,
    HorizontalBox,
    GroupBox,
    CheckBox,
    Palette,
    TextEdit,
    ScrollView,
} from "std-widgets.slint";





component SectionLabel inherits Text {
    font-weight: 600;
    font-size: 12px;
    color: Palette.foreground.transparentize(40%);
    horizontal-alignment: left;
}

export component MainWindow inherits Window {
    title: "Resolvefy";
    preferred-width: 600px;
    preferred-height: contenido.preferred-height + contenido.preferred-height / 20;

    background: Palette.background;

    callback pick-input();
    callback pick-output();
    callback convert-clicked();
    callback mode-changed(int);

    in-out property <string> input-path: "";
    in-out property <string> info-text: "";
    in-out property <bool> info-visible: false;
    in-out property <string> output-path: "";
    in-out property <string> status-text: "Preparado";
    in-out property <float> progress-value: 0.0;
    in-out property <bool> output-enabled: false;
    in-out property <bool> convert-enabled: false;
    in-out property <string> convert-label: "Convertir";
    in-out property <bool> advanced-visible: false;
    in-out property <bool> bitrate-visible: false;
    in-out property <string> crf-text: "24";
    in-out property <string> bitrate-text: "5000";

    ScrollView {
        vertical-scrollbar-policy: as-needed;
        horizontal-scrollbar-policy: as-needed;
        HorizontalLayout {
            alignment: space-evenly;
            contenido := VerticalLayout {
                alignment: start;
                spacing: 8px;
                padding: 32px;
                // max-width: 600px;
                preferred-width: 600px;

                GroupBox {
                    title: "Archivo de entrada";

                    VerticalLayout {
                        HorizontalBox {
                            alignment: stretch;

                            LineEdit {
                                placeholder-text: "Ningún archivo seleccionado";
                                text: root.input-path;
                                read-only: true;
                            }

                            Button {
                                text: "Examinar…";

                                clicked => {
                                    root.pick-input();
                                }
                            }
                        }

                        if root.info-visible: Text {
                            text: root.info-text;
                            font-size: 12px;
                            wrap: word-wrap;
                            color: Palette.foreground.transparentize(20%);
                        }
                    }
                }

                GroupBox {
                    title: "Guardar como";

                    HorizontalBox {
                        alignment: stretch;

                        LineEdit {
                            placeholder-text: "Sin ruta de salida";
                            text: root.output-path;
                            read-only: true;
                            edited(text) => { root.output-path = text }
                        }

                        Button {
                            text: "Examinar…";
                            enabled: root.output-enabled;
                            clicked => {
                                root.pick-output();
                            }
                        }
                    }
                }

                GroupBox {
                    title: "Avanzado";

                    VerticalLayout {
                        CheckBox {
                            text: "Mostrar opciones avanzadas";
                            toggled => {
                                root.advanced-visible = self.checked;
                            }
                        }

                        Rectangle {
                            height: root.advanced-visible ? rect.min-height : 0px;
                            clip: true;
                            background: transparent;

                            animate height {
                                duration: 250ms;
                                easing: ease-in-out;
                            }

                            rect := VerticalBox {
                                opacity: root.advanced-visible ? 1.0 : 0.0;

                                animate opacity {
                                    duration: 200ms;
                                    easing: ease-in-out;
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    SectionLabel {
                                        text: "Modo";
                                    }

                                    ComboBox {
                                        model: ["CRF (calidad constante)", "CBR (bitrate constante)"];
                                        current-index: 0;
                                        height: 32px;
                                        selected => {
                                            root.mode-changed(self.current-index);
                                        }
                                    }
                                }

                                if !root.bitrate-visible: VerticalLayout {
                                    spacing: 4px;
                                    SectionLabel {
                                        text: "Valor CRF (1–63)";
                                    }

                                    LineEdit {
                                        text: root.crf-text;
                                        placeholder-text: "24";
                                        height: 32px;
                                        edited => {
                                            root.crf-text = self.text;
                                        }
                                    }
                                }

                                if root.bitrate-visible: VerticalBox {

                                    SectionLabel {
                                        text: "Bitrate constante (kbps)";
                                    }

                                    LineEdit {
                                        text: root.bitrate-text;
                                        placeholder-text: "5000";
                                        height: 32px;
                                        edited => {
                                            root.bitrate-text = self.text;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalBox {

                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: root.status-text;
                                font-size: 12px;
                                color: Palette.foreground.transparentize(40%);
                                vertical-alignment: center;
                            }

                            if root.progress-value > 0: Text {
                                text: Math.round(root.progress-value) + "%";
                                font-size: 12px;
                                font-weight: 600;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                        }

                        ProgressIndicator {
                            progress: root.progress-value / 100;
                            indeterminate: false;
                            animate progress { duration: 250ms; }
                        }
                    }

                    Button {
                        text: root.convert-label;
                        enabled: root.convert-enabled;
                        primary: true;
                        clicked => {
                            root.convert-clicked();
                        }
                    }
                }
            }
        }
    }
}
