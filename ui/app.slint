import { Button, VerticalBox, HorizontalBox, ComboBox, LineEdit,
         GroupBox, ProgressIndicator, ScrollView, RadioGroup, Palette,
         GridBox } from "std-widgets.slint";

export enum EncodeMode { CRF, CBR }
export enum Container { MKV, MP4 }

export struct InputInfo {
    video-codec: string,
    audio-codec: string,
    duration-secs: float,
    is-video-av1: bool,
    is-audio-opus: bool,
}

export component AppWindow inherits Window {
    title: "Resolvefy — Conversor a AV1";
    preferred-width: 650px;
    preferred-height: 650px;
    background: Palette.background;

    in-out property <string> input-path: "";
    in-out property <string> output-path: "";
    in-out property <string> input-info-text: "";
    in-out property <EncodeMode> encode-mode: EncodeMode.CRF;
    in-out property <Container> container: Container.MKV;
    in-out property <int> crf-value: 30;
    in-out property <int> bitrate-kbps: 5000;
    in-out property <bool> is-encoding: false;
    in-out property <float> progress: 0.0;
    in-out property <string> status-text: "Preparado";
    in-out property <bool> is-error: false;
    in-out property <bool> can-encode: false;
    in property <length> vertical-breakpoint: 500px;
    in property <length> button-height: 40px;

    callback pick-input();
    callback pick-output();
    callback start-encode();
    callback mode-changed(string);
    callback container-changed(string);
    callback crf-changed(string);
    callback bitrate-changed(string);

    ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: as-needed;
        horizontal-scrollbar-policy: as-needed;

        VerticalBox {
            padding: 24px;
            spacing: 16px;
            width: min(parent.width, 650px);

            // Title
            Text {
                text: "Resolvefy — Conversor a AV1";
                font-size: 20px;
                font-weight: 700;
                color: Palette.accent-background;
                horizontal-alignment: center;
            }

            // Input + Output side by side (or stacked when narrow)
            if root.width < vertical-breakpoint : VerticalBox {
                spacing: 16px;

                // Input section
                GroupBox {
                    title: "Entrada";
                    vertical-stretch: 0;

                    VerticalBox {
                        spacing: 8px;
                        Button {
                            text: "Seleccionar vídeo...";
                            clicked => { root.pick-input(); }
                            height: button-height;
                        }
                        Text {
                            text: root.input-path != "" ? root.input-path : "Ningún archivo seleccionado";
                            font-size: 12px;
                            color: Palette.foreground;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            background: Palette.alternate-background;
                            border-radius: 8px;
                            vertical-stretch: 0;
                            height: info-content.preferred-height + 16px;
                            visible: root.input-info-text != "";

                            info-content := VerticalBox {
                                padding: 10px;
                                Text {
                                    text: root.input-info-text;
                                    font-size: 12px;
                                    color: Palette.foreground;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // Output section
                GroupBox {
                    title: "Salida";
                    vertical-stretch: 0;

                    VerticalBox {
                        spacing: 8px;
                        Button {
                            text: "Guardar como...";
                            enabled: root.input-path != "";
                            clicked => { root.pick-output(); }
                            height: button-height;
                        }
                        Text {
                            text: root.output-path != "" ? root.output-path : "Sin ruta de salida";
                            font-size: 12px;
                            color: Palette.foreground;
                            wrap: word-wrap;
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text {
                                text: "Contenedor:";
                                font-size: 12px;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                height: button-height;
                                model: ["MKV", "MP4"];
                                current-value: root.container == Container.MKV ? "MKV" : "MP4";
                                selected(value) => {
                                    root.container-changed(value);
                                }
                            }
                        }
                    }
                }
            }

            if root.width >= vertical-breakpoint : HorizontalLayout {
                spacing: 16px;
                alignment: stretch;

                // Input section
                GroupBox {
                    title: "Entrada";
                    vertical-stretch: 0;
                    horizontal-stretch: 1;
                    min-width: 200px;

                    VerticalBox {
                        spacing: 8px;
                        Button {
                            text: "Seleccionar vídeo...";
                            clicked => { root.pick-input(); }
                            height: button-height;
                        }
                        Text {
                            text: root.input-path != "" ? root.input-path : "Ningún archivo seleccionado";
                            font-size: 12px;
                            color: Palette.foreground;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            background: Palette.alternate-background;
                            border-radius: 8px;
                            vertical-stretch: 0;
                            height: wide-content.preferred-height + 16px;
                            visible: root.input-info-text != "";

                            wide-content := VerticalBox {
                                padding: 10px;
                                Text {
                                    text: root.input-info-text;
                                    font-size: 12px;
                                    color: Palette.foreground;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // Output section
                GroupBox {
                    title: "Salida";
                    vertical-stretch: 0;
                    horizontal-stretch: 1;
                    min-width: 200px;

                    VerticalBox {
                        spacing: 8px;
                        Button {
                            text: "Guardar como...";
                            enabled: root.input-path != "";
                            clicked => { root.pick-output(); }
                            height: button-height;
                        }
                        Text {
                            text: root.output-path != "" ? root.output-path : "Sin ruta de salida";
                            font-size: 12px;
                            color: Palette.foreground;
                            wrap: word-wrap;
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text {
                                text: "Contenedor:";
                                font-size: 12px;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                model: ["MKV", "MP4"];
                                current-value: root.container == Container.MKV ? "MKV" : "MP4";
                                selected(value) => {
                                    root.container-changed(value);
                                }
                            }
                        }
                    }
                }
            }

            // Encoding section
            GroupBox {
                title: "Codificación";
                vertical-stretch: 0;

                VerticalBox {
                    spacing: 10px;
                    if root.width < vertical-breakpoint : RadioGroup {
                        title: "Modo de codificación";
                        orientation: vertical;
                        enabled: !root.is-encoding;
                        selected(value) => {
                            root.mode-changed(value == "CRF (calidad constante)" ? "crf" : "cbr");
                        }
                        RadioButton {
                            text: "CRF (calidad constante)";
                            checked: root.encode-mode == EncodeMode.CRF;
                        }
                        RadioButton {
                            text: "Bitrate constante (CBR)";
                            checked: root.encode-mode == EncodeMode.CBR;
                        }
                    }

                    if root.width >= vertical-breakpoint : RadioGroup {
                        title: "Modo de codificación";
                        orientation: horizontal;
                        enabled: !root.is-encoding;
                        selected(value) => {
                            root.mode-changed(value == "CRF (calidad constante)" ? "crf" : "cbr");
                        }
                        RadioButton {
                            text: "CRF (calidad constante)";
                            checked: root.encode-mode == EncodeMode.CRF;
                        }
                        RadioButton {
                            text: "Bitrate constante (CBR)";
                            checked: root.encode-mode == EncodeMode.CBR;
                        }
                    }

                    // CRF + Bitrate on same row
                    HorizontalBox {
                        spacing: 24px;
                        alignment: start;

                        HorizontalBox {
                            spacing: 8px;
                            opacity: root.encode-mode == EncodeMode.CRF ? 1.0 : 0.4;
                            Text {
                                text: "CRF:";
                                font-size: 12px;
                                color: Palette.foreground;
                                vertical-alignment: center;
                                width: 40px;
                            }
                            LineEdit {
                                text: root.crf-value;
                                width: 60px;
                                enabled: root.encode-mode == EncodeMode.CRF;
                                accepted(value) => { root.crf-changed(value); }
                            }
                            Text {
                                text: "(0–63)";
                                font-size: 11px;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            opacity: root.encode-mode == EncodeMode.CBR ? 1.0 : 0.4;
                            Text {
                                text: "Bitrate:";
                                font-size: 12px;
                                color: Palette.foreground;
                                vertical-alignment: center;
                                width: 55px;
                            }
                            LineEdit {
                                text: root.bitrate-kbps;
                                width: 60px;
                                enabled: root.encode-mode == EncodeMode.CBR;
                                accepted(value) => { root.bitrate-changed(value); }
                            }
                            Text {
                                text: "kbps";
                                font-size: 11px;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Button + Status side by side
                Button {
                    text: root.is-encoding ? "Convirtiendo..." : "Convertir";
                    primary: true;
                    enabled: root.can-encode && !root.is-encoding;
                    clicked => { root.start-encode(); }
                    horizontal-stretch: 0;
                    height: button-height;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                    height: status.preferred-height;

                    status := Text {
                        text: root.status-text != "" ? root.status-text : "Preparado";
                        font-size: 12px;
                        color: Palette.foreground;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

            ProgressIndicator {
                progress: root.progress;
            }
        }
    }
}
