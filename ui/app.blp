using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow {
    id: "window";
    title: "Resolvefy";
    default-width: 650;
    default-height: 650;

    Adw.ToolbarView {
        Adw.HeaderBar {}

        Adw.Clamp {
            maximum-size: 600;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            Gtk.Box {
                orientation: vertical;
                spacing: 12;

                Gtk.Label {
                    label: "Resolvefy";
                    css-classes: ["title-1"];
                    halign: center;
                }

                Gtk.Label {
                    label: "Conversor de vídeo a AV1";
                    css-classes: ["dim-label"];
                    halign: center;
                }

                Adw.PreferencesGroup {
                    title: "Entrada";

                    Adw.ActionRow {
                        title: "Archivo de vídeo";
                        activatable: true;

                        Gtk.Button {
                            id: "pick_input_btn";
                            label: "Seleccionar…";
                            valign: center;
                        }

                        activatable-widget: pick_input_btn;
                    }

                    Gtk.Label {
                        id: "input_path_label";
                        label: "Ningún archivo seleccionado";
                        wrap: true;
                        xalign: 0.0;
                        css-classes: ["dim-label"];
                    }

                    Adw.Revealer {
                        id: "info_revealer";
                        transition-type: slide-down;

                        Gtk.Label {
                            id: "info_label";
                            wrap: true;
                            xalign: 0.0;
                        }
                    }
                }

                Adw.PreferencesGroup {
                    title: "Salida";

                    Adw.ActionRow {
                        title: "Guardar como";
                        activatable: true;

                        Gtk.Button {
                            id: "pick_output_btn";
                            label: "Seleccionar…";
                            valign: center;
                            sensitive: false;
                        }

                        activatable-widget: pick_output_btn;
                    }

                    Gtk.Label {
                        id: "output_path_label";
                        label: "Sin ruta de salida";
                        wrap: true;
                        xalign: 0.0;
                        css-classes: ["dim-label"];
                    }

                    Adw.ComboRow {
                        id: "container_row";
                        title: "Contenedor";
                    }
                }

                Adw.PreferencesGroup {
                    title: "Codificación";

                    Adw.ComboRow {
                        id: "mode_combo";
                        title: "Modo de codificación";
                        selected: 0;
                    }

                    Adw.EntryRow {
                        id: "crf_row";
                        title: "Valor CRF (0–63)";
                        text: "30";
                    }

                    Adw.EntryRow {
                        id: "bitrate_row";
                        title: "Bitrate (kbps)";
                        text: "5000";
                        visible: false;
                    }
                }

                Gtk.Button {
                    id: "convert_button";
                    label: "Convertir";
                    css-classes: ["suggested-action"];
                    halign: end;
                    sensitive: false;
                }

                Gtk.Label {
                    id: "status_label";
                    label: "Preparado";
                    wrap: true;
                    xalign: 0.0;
                    css-classes: ["dim-label"];
                }

                Gtk.ProgressBar {
                    id: "progress_bar";
                }
            }
        }
    }
}
