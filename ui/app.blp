using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: _("Resolvefy");
  default-width: 650;
  default-height: 650;

  Adw.ToolbarView toolbar_view {
    Adw.HeaderBar header_bar {}

    Adw.Clamp clamp {
      maximum-size: 600;
      margin-top: 12;
      margin-bottom: 50;
      margin-start: 12;
      margin-end: 12;

      Gtk.Box {
        orientation: vertical;
        spacing: 12;

        Gtk.Label {
          label: _("Resolvefy");

          styles [
            "title-1",
          ]

          halign: center;
        }

        Gtk.Label {
          label: _("Conversor de vídeo a AV1");

          styles [
            "dim-label",
          ]

          halign: center;
        }

        Adw.PreferencesGroup {
          title: _("Entrada");

          Adw.ActionRow {
            title: _("Archivo de vídeo");
            activatable: true;

            Gtk.Button pick_input_btn {
              label: _("Seleccionar…");
              valign: center;
            }

            activatable-widget: pick_input_btn;
          }

          Gtk.Label input_path_label {
            label: _("Ningún archivo seleccionado");
            wrap: true;
            xalign: 0.0;

            styles [
              "dim-label",
            ]
          }

          Gtk.Revealer info_revealer {
            transition-type: slide_down;

            Gtk.Label info_label {
              wrap: true;
              xalign: 0.0;
            }
          }
        }

        Adw.PreferencesGroup {
          title: _("Salida");

          Adw.ActionRow {
            title: _("Guardar como");
            activatable: true;

            Gtk.Button pick_output_btn {
              label: _("Seleccionar…");
              valign: center;
              sensitive: false;
            }

            activatable-widget: pick_output_btn;
          }

          Gtk.Label output_path_label {
            label: _("Sin ruta de salida");
            wrap: true;
            xalign: 0.0;

            styles [
              "dim-label",
            ]
          }

          Adw.ComboRow container_row {
            title: _("Contenedor");
          }
        }

        Adw.PreferencesGroup {
          title: _("Codificación");

          Adw.ComboRow mode_combo {
            title: _("Modo de codificación");
            selected: 0;
          }

          Adw.EntryRow crf_row {
            title: _("Valor CRF (0 –63)");
            text: _("30");
          }

          Adw.EntryRow bitrate_row {
            title: _("Bitrate (kbps)");
            text: _("5000");
            visible: false;
          }
        }

        Gtk.Label status_label {
          label: _("Preparado");
          wrap: true;
          xalign: 0.0;
          styles ["dim-label"]
        }

        Gtk.Box progress_row {
          orientation: horizontal;
          spacing: 12;

          Gtk.Label progress_text_label {
            label: "";
            styles ["dim-label"]
            xalign: 0.0;
          }

          Gtk.ProgressBar progress_bar {}
        }

        Gtk.Button convert_button {
          label: _("Convertir");
          styles ["suggested-action", "pill"]
          halign: center;
          sensitive: false;
        }
      }
    }
  }
}
